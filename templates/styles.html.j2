.notebook-form{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.notebook-form>label:first-child,.notebook-form>label:last-of-type,.notebook-form>.actions{grid-column:1/-1}
.notebook-form textarea{font-size:15px;line-height:1.5;min-height:88px}.notebook-form textarea::placeholder{color:#6b7b81;font-size:14px;font-weight:400}
.notebook-form>.actions{align-items:center;margin-top:0}.note-save-status{font-size:12px;color:var(--muted);margin-right:auto}
