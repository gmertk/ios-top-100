.notebook-link span{margin-left:6px;font-variant-numeric:tabular-nums}
.report-date{font-size:12px;color:var(--muted);white-space:nowrap}
.hero{padding:32px 0 18px}.hero h1{font-size:clamp(34px,4vw,48px)}
