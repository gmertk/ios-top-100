caption{text-align:left;padding:14px 16px;color:var(--muted);font-size:12px}
tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#f7faf8}
td button[data-notebook-save]{white-space:nowrap;background:var(--accent);color:var(--green);border-color:#c6ded3}
#notebook{scroll-margin-top:0;border-color:#c6ded3;background:#fbfdfb}
