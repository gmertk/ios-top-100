.results-count{font-size:13px;margin:0 0 18px}.card{display:flex;flex-direction:column;padding:22px;border-radius:16px;box-shadow:0 3px 12px #172d3405}
.card .app{min-height:52px}.card .badge{align-self:flex-start}.card>.actions{margin-top:auto;padding-top:20px;align-items:flex-start}
