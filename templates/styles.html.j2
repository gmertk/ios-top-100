button[data-notebook-save]{min-height:40px;padding:9px 14px;font-size:13px}
button[data-notebook-save][data-saved=true]{background:var(--accent);color:var(--green);border-color:#c6ded3}
button:hover{filter:brightness(.97)}button:disabled{opacity:.55;cursor:default}
