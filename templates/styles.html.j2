.stat{padding:12px 20px 20px}.stat:first-child{padding-left:0}.stat strong{font-size:25px}
.stat+.stat{border-left:0}.section-top p{max-width:660px;font-size:15px}
.filter-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
