<style>
:root{color-scheme:light;--ink:#172d34;--muted:#53656c;--line:#dce4e5;--green:#12614e;--paper:#f4f7f6;--accent:#e9f5ef}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--green);text-underline-offset:3px}a:hover{text-decoration:underline}button,select,input{font:inherit}button,select{border:1px solid #a4b5b2;border-radius:8px;background:#fff;color:var(--ink);padding:8px 12px}button{cursor:pointer}a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #267eae;outline-offset:4px}[hidden]{display:none!important}.wrap{max-width:1180px;margin:auto;padding:32px 24px}nav{display:flex;justify-content:space-between;gap:20px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:18px}.brand{font-weight:750;letter-spacing:-.5px;text-decoration:none}.eyebrow{text-transform:uppercase;letter-spacing:1.5px;font-size:12px;font-weight:750;color:var(--green);margin:0 0 8px}h1{font-size:clamp(32px,4.5vw,52px);line-height:1.12;letter-spacing:-1.8px;margin:14px 0}h2{font-size:26px;letter-spacing:-.6px;margin:0}h3{font-size:18px;line-height:1.3;margin:0 0 4px}p{margin:8px 0 16px}.muted,small{color:var(--muted)}.intro{max-width:740px;font-size:18px}.hero{padding:40px 0 26px}.stats{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:12px;background:#fff;margin:0 0 32px}.stat{padding:20px 24px}.stat+.stat{border-left:1px solid var(--line)}.stat strong{display:block;font-size:30px;letter-spacing:-1px}.stat span{color:var(--muted);font-size:14px}.notice{border-left:4px solid #b78936;background:#fff7e5;padding:16px 20px;border-radius:4px;margin-bottom:32px}.notice p{margin:4px 0}.section{margin:0 0 44px}.section-top{display:flex;justify-content:space-between;gap:20px;align-items:start;margin-bottom:18px}.section-top p{margin:6px 0 0;max-width:750px}.control{display:flex;gap:10px;align-items:center;flex-shrink:0}.empty{border:1px dashed #a9bbb6;border-radius:12px;padding:30px;background:#fff}.empty h3{font-size:21px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:22px;min-width:0}.app{display:flex;align-items:center;gap:12px;margin:0 0 16px}.app img{width:52px;height:52px;border-radius:12px;flex-shrink:0}.app a{color:var(--ink);text-decoration:none}.app a:hover{text-decoration:underline}.app div{min-width:0;overflow-wrap:anywhere}.app small{font-size:12px}.gain{font-size:28px;font-weight:750;color:var(--green);letter-spacing:-1px}.badge{display:inline-block;font-size:12px;font-weight:650;background:var(--accent);color:var(--green);padding:4px 8px;border-radius:5px;margin:4px 4px 4px 0}.metric{border-top:1px solid var(--line);margin-top:14px;padding-top:14px}.metric p{margin:5px 0;font-size:14px}.spark{width:100%;height:75px;display:block;margin:12px 0 2px}.spark circle{fill:var(--green)}.spark line{stroke:var(--green);stroke-width:2}.spark .gridline{stroke:var(--line);stroke-width:1}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;background:#fff;margin-top:20px}table{border-collapse:collapse;width:100%;font-size:14px;text-align:left}td,th{padding:12px 16px;border-bottom:1px solid var(--line)}th{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.5px}td.numeric{font-variant-numeric:tabular-nums;white-space:nowrap}details{border:1px solid var(--line);border-radius:10px;background:#fff;margin:12px 0}summary{cursor:pointer;padding:16px;font-weight:650}.content{padding:0 18px 18px}.category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}.category-grid .app{margin:0}.category-grid img{width:44px;height:44px}.filter{display:flex;gap:16px;border:0;padding:0;margin:18px 0}.filter legend{margin-bottom:6px;font-weight:650}.card details{border:0;border-top:1px solid var(--line);border-radius:0;margin-bottom:0}.card summary{font-size:13px;padding:12px 0 0}.card details ul{font-size:13px;padding-left:20px}.archive{list-style:none;padding:0;margin:0}.archive li{display:flex;justify-content:space-between;gap:16px;background:#fff;padding:16px 20px;border-bottom:1px solid var(--line)}footer{border-top:1px solid var(--line);padding-top:20px;color:var(--muted);font-size:13px}.skip{position:absolute;top:-80px}.skip:focus{top:10px;background:#fff;padding:10px}.research{font-size:13px;color:var(--muted);margin-top:18px}
@media(max-width:650px){.wrap{padding:20px 16px}.section-top{flex-direction:column;gap:14px}.stats .stat{padding:14px 10px}.stat strong{font-size:24px}.stat span{font-size:12px}.hero{padding-top:28px}.cards{grid-template-columns:1fr}nav{font-size:14px}.intro{font-size:16px}h1{letter-spacing:-1px}}
</style>
