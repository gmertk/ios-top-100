-size:21px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:22px;min-width:0}.app{display:flex;align-items:center;gap:12px;margin:0 0 16px}.app img{width:52px;height:52px;border-radius:12px;flex-shrink:0}.app a{color:var(--ink);text-decoration:none}.app a:hover{text-decoration:underline}.app div{min-width:0;overflow-wrap:anywhere}.app small{font-size:12px}.gain{font-size:28px;font-weight:750;color:var(--green);letter-spacing:-1px}.badge{display:inline-block;font-size:12px;font-weight:650;background:var(--accent);color:var(--green);padding:4px 8px;border-radius:5px;margin:4px 4px 4px 0}.metric{border-top:1px solid var(--line);margin-top:14px;padding-top:14px}.metric p{margin:5px 0;font-size:14px}.spark{width:100%;height:75px;display:block;margin:12px 0 2px}.spark circle{fill:var(--green)}.spark line{stroke:var(--green);stroke-width:2}.spark .gridline{stroke:var(--line);stroke-width:1}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;background:#fff;margin-top:20px}table{border-collapse:collapse;width:100%;font-size:14px;text-align:left}td,th{padding:12px 16px;border-bottom:1px solid var(--line)}th{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.5px}td.numeric{font-variant-numeric:tabular-nums;white-space:nowrap}details{border:1px solid var(--line);border-radius:10px;background:#fff;margin:12px 0}summary{cursor:pointer;padding:16px;font-weight:650}.content{padding:0 18px 18px}.category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}.category-grid .app{margin:0}.category-grid img{width:44px;height:44px}.filter{display:flex;gap:16px;border:0;padding:0;margin:18px 0}.filter legend{margin-bottom:6px;font-weight:650}.card details{border:0;border-top:1px solid var(--line);border-radius:0;margin-bottom:0}.card summary{font-size:13px;padding:12px 0 0}.card details ul{font-size