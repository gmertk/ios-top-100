@media(max-width:650px){
  .nav-links{gap:6px}.nav-links a{font-size:12px}.nav-links .notebook-link{padding:9px 8px}
  .category-toolbar{padding:16px}.category-controls{grid-template-columns:1fr 1fr;gap:12px}.category-search{grid-column:1/-1}
