<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ site_title }}</title>{% include 'styles.html.j2' %}</head><body><div class="wrap"><nav><span class="brand">{{ site_title }}</span><span class="muted">{{ country|upper }} App Store</span></nav><header class="hero"><p class="eyebrow">Daily discovery brief</p><h1>Follow the momentum.</h1><p class="intro muted">Discover climbing apps and recent releases. Explore the evidence behind your next app idea.</p>{% if reports %}<p><a href="{{ reports[0].href }}">Open latest report · {{ reports[0].date }} →</a></p>{% endif %}</header><main class="section"><h2>Report archive</h2><p class="muted">New reports count unique newly observed apps. Legacy reports may count the same app in multiple categories.</p><ul class="archive">{% for r in reports %}<li><a href="{{ r.href }}">{{ r.date }}</a><span class="muted">{{ r.total_new }} newly observed</span></li>{% endfor %}</ul></main><footer>Generated {{ now }}</footer></div></body></html>
